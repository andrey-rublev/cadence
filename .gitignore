# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
*.tsbuildinfo

# Local databases and secrets
*.db
# Snapshots of collected volunteer data are shared on purpose (private repo).
# The live database each laptop writes to, backend/cadence.db, is never tracked:
# a pull would overwrite that laptop's recordings.
!/data/collected/*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# External data and volunteer exports
data/external/
data/volunteer/

# Model artifacts are reproducible from scripts. The deployed passive models (about 120 KB
# each) are committed so a fresh clone works without downloading the datasets.
artifacts/models/*
!artifacts/models/.gitkeep
!artifacts/models/keys/
!artifacts/models/keys-login/
!artifacts/models/keys-history/
!artifacts/models/pointer/

# Tooling
.playwright-mcp/
.DS_Store
Thumbs.db

# Separate working copies for development while collection runs
.worktrees/
