{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cadence",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "backend",
        "uvicorn",
        "cadence.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "sandbox-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set CADENCE_ALLOW_SYNTHETIC_MODEL=1&& uv run --project C:/Users/nikhi/Downloads/GitHub/cadence/.worktrees/dev/backend uvicorn cadence.main:app --port 8001"
      ],
      "port": 8001
    },
    {
      "name": "sandbox-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set CADENCE_API=http://127.0.0.1:8001&& npm --prefix C:/Users/nikhi/Downloads/GitHub/cadence/.worktrees/dev/apps/web run dev -- --port 5174"
      ],
      "port": 5174
    }
  ]
}
