{
  "name": "cadence",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "setup": "uv sync --project backend && npm install",
    "start": "node scripts/start.mjs",
    "share": "uv run --project backend python backend/scripts/share_data.py",
    "dev": "npm run dev -w @cadence/web",
    "build": "npm run build -w @cadence/web && npm run build -w @cadence/partner",
    "typecheck": "npm run typecheck -w @cadence/sdk && npm run build -w @cadence/web && npm run build -w @cadence/partner",
    "typing": "uv run --project backend python backend/scripts/typing_eval.py",
    "typing:calibrate": "uv run --project backend python backend/scripts/typing_eval.py --calibrate"
  }
}
